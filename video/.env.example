# コピーして .env にする（.env は .gitignore 済み）。bun が cwd の .env を自動で読む。
# クラウド routine では環境として同じ値を設定する。

# AssemblyAI（クラウドでの文字起こし: 単語タイムスタンプ + 話者分離）
# transcribe-cloud.mjs が使う。1話あたり約 $0.17
ASSEMBLYAI_API_KEY=

# Cloudflare R2（クリップの配信先 clips.magical.fm）
# 3つ揃っていれば upload-clip.mjs が S3 互換 API を直接叩く。
# 揃っていない場合は `bunx wrangler login` 済みの wrangler にフォールバックする
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# wrangler 経由で R2 を操作する場合に使う
CLOUDFLARE_API_TOKEN=

# YouTube Data API v3（publish-social.mjs のアップロード用）
# Google Cloud の「デスクトップアプリ」OAuth クライアントの値。
# REFRESH_TOKEN は `bun scripts/youtube-auth.mjs` で取得する（.env に自動で書き込まれる）。
# 承認画面では投稿先のチャンネルを選ぶこと
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Graph API（publish-social.mjs の Reels 投稿用）
# Meta App の「Instagramログインによる API設定」で生成する長期トークン（60日）。
# 投稿のたびに publish-social.mjs が自動で延長して、この .env を書き戻す
IG_ACCESS_TOKEN=
IG_USER_ID=

# Facebook ログイン経由のトークンを使う場合のみ（既定は graph.instagram.com）
# IG_API_HOST=graph.facebook.com

# 短期トークンを長期に交換するときだけ使う（instagram-auth.mjs exchange）
# IG_APP_SECRET=
