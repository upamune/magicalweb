    "index": 134,
    "start": 412.788,
    "end": 413.068,
    "speaker": 0,
    "text": "確かに。"
  },
  {
    "index": 135,
    "start": 413.628,
    "end": 415.028,
    "speaker": 1,
    "text": "それ使ったりします。"
  },
  {
    "index": 136,
    "start": 415.108,
    "end": 415.648,
    "speaker": 0,
    "text": "やってみよ。"
  },
  {
    "index": 137,
    "start": 417.428,
    "end": 417.788,
    "speaker": 1,
    "text": "私は"
  },
  {
    "index": 138,
    "start": 418.808,
    "end": 420.108,
    "speaker": 1,
    "text": "基本的に技"
  },
  {
    "index": 139,
    "start": 421.008,
    "end": 423.148,
    "speaker": 1,
    "text": "術書を買うことがほとんどで、"
  },
  {
    "index": 140,
    "start": 425.008,
    "end": 431.288,
    "speaker": 1,
    "text": "私は大体Kindleなんですけど、最近は技術書はKindleで買うのをやめたっていう感じですね。"
  },
  {
    "index": 141,
    "start": 431.348,
    "end": 431.927,
    "speaker": 0,
    "text": "うーん。"
