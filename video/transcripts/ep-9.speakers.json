[
  {
    "index": 0,
    "start": 4.76,
    "end": 14.24,
    "speaker": 0,
    "text": "マヂカル.fmは関西人のプロダクトマネージャーみちるだと、関西人括弧ハテナのソフトウェアエンジニアのうぱみゅんがほぼ週2で配信する雑談ポッドキャストです。"
  },
  {
    "index": 1,
    "start": 14.32,
    "end": 15.82,
    "speaker": 0,
    "text": "よろしくお願いします。"
  },
  {
    "index": 2,
    "start": 15.86,
    "end": 16.48,
    "speaker": 1,
    "text": "お願いします。"
  },
  {
    "index": 3,
    "start": 17.52,
    "end": 21.68,
    "speaker": 0,
    "text": "なんと前回に引き続き、今回もお便りが来ています。"
  },
  {
    "index": 4,
    "start": 21.76,
    "end": 22.2,
    "speaker": 1,
    "text": "素晴らしい。"
  },
  {
    "index": 5,
    "start": 22.22,
    "end": 23.04,
    "speaker": 1,
    "text": "ありがたいですね。"
  },
  {
    "index": 6,
    "start": 23.58,
    "end": 23.78,
    "speaker": 0,
    "text": "はい。"
  },
  {
    "index": 7,
    "start": 24.2,
    "end": 26.96,
    "speaker": 0,
    "text": "お名前はトロピカル確定申告さんから。「"
  },
  {
    "index": 8,
    "start": 28.18,
    "end": 29.9,
    "speaker": 0,
    "text": "失神の話面白かったです。"
  },
  {
    "index": 9,
    "start": 30.04,
    "end": 32.479,
    "speaker": 0,
    "text": "人生で失神したことがないので勉強になりました。"
  },
  {
    "index": 10,
    "start": 33.32,
    "end": 35.8,
    "speaker": 0,
    "text": "いいグランマになるための対策の話も良かったです。"
  },
  {
    "index": 11,
    "start": 36.42,
    "end": 42.38,
    "speaker": 0,
    "text": "ちなみに僕の嫌なおじさん仕草は電車で足をめっちゃ開く、店員さんにタメ口を聞くです。"
  },
  {
    "index": 12,
    "start": 43.16,
    "end": 45.12,
    "speaker": 0,
    "text": "足は程々の開脚度なら許します。"
  },
  {
    "index": 13,
    "start": 45.26,
    "end": 46.56,
    "speaker": 0,
    "text": "対戦よろしくお願いします」"
  },
  {
    "index": 14,
    "start": 47.36,
    "end": 48.06,
    "speaker": 0,
    "text": "とのことです。"
  },
  {
    "index": 15,
    "start": 48.22,
    "end": 48.98,
    "speaker": 1,
    "text": "ありがとうございます。"
  },
  {
    "index": 16,
    "start": 49.28,
    "end": 50.38,
    "speaker": 0,
    "text": "ありがとうございます。"
  },
  {
    "index": 17,
    "start": 50.44,
    "end": 51.62,
    "speaker": 0,
    "text": "ありがたいですね。"
  },
  {
    "index": 18,
    "start": 53.2,
    "end": 54.64,
    "speaker": 0,
    "text": "店員にタメ口きいちゃうな。"
  },
  {
    "index": 19,
    "start": 55.16,
    "end": 55.26,
    "speaker": 1,
    "text": "え？"
  },
  {
    "index": 20,
    "start": 56.5,
    "end": 58.18,
    "speaker": 1,
    "text": "これなんかおじさんっていうかなんかな。"
  },
  {
    "index": 21,
    "start": 58.74,
    "end": 70.18,
    "speaker": 1,
    "text": "常に、私の場合は店員さんにタメ口聞いたことないんですけど、なんか常に自分が申し訳ないと思ってしまうから、こんな注文してごめんなさいって思いながら生きてるから、タメ口聞いたことないですね。"
  },
  {
    "index": 22,
    "start": 70.56,
    "end": 71.38,
    "speaker": 0,
    "text": "そうなんですね。"
  },
  {
    "index": 23,
    "start": 71.66,
    "end": 74.16,
    "speaker": 0,
    "text": "自分結構そうなんだとか言っちゃいますね。"
  },
  {
    "index": 24,
    "start": 74.26,
    "end": 76.94,
    "speaker": 1,
    "text": "ああ、そういう感じのタメ口？"
  },
  {
    "index": 25,
    "start": 77.1,
    "end": 78.04,
    "speaker": 0,
    "text": "どういう感じのタメ口？"
  },
  {
    "index": 26,
    "start": 78.12,
    "end": 79.38,
    "speaker": 1,
    "text": "それはいいんじゃないですか？"
  },
  {
    "index": 27,
    "start": 80.5,
    "end": 82.82,
    "speaker": 1,
    "text": "なんか「おい、早く持ってこい」とかそういうことと思った。"
  },
  {
    "index": 28,
    "start": 83.12,
    "end": 84.58,
    "speaker": 0,
    "text": "それタメ口じゃなくて。"
  },
  {
    "index": 29,
    "start": 84.84,
    "end": 85.1,
    "speaker": 1,
    "text": "暴言？"
  },
  {
    "index": 30,
    "start": 87.08,
    "end": 87.98,
    "speaker": 0,
    "text": "失礼な発言。"
  },
  {
    "index": 31,
    "start": 89.12,
    "end": 94.9,
    "speaker": 1,
    "text": "あ、そういうことでいうと、なんか私もなんかタイ料理のおじさんに何か友達みたいな感じで話してましたもんね。"
  },
  {
    "index": 32,
    "start": 94.94,
    "end": 95.6,
    "speaker": 0,
    "text": "そうですよね。"
  },
  {
    "index": 33,
    "start": 95.8,
    "end": 95.98,
    "speaker": 0,
    "text": "うん。"
  },
  {
    "index": 34,
    "start": 96.32,
    "end": 101.82,
    "speaker": 1,
    "text": "でもあれが悪いか、いい、悪いおじさんがっていうと、悪い、そんな悪くはないと思うんですけど、どうなんですか？"
  },
  {
    "index": 35,
    "start": 102.36,
    "end": 105.4,
    "speaker": 0,
    "text": "まあでもおじさんに言われたら嫌かもしれないですよね。"
  },
  {
    "index": 36,
    "start": 106.42,
    "end": 108.94,
    "speaker": 1,
    "text": "今この年齢だから許されてるってこと？"
  },
  {
    "index": 37,
    "start": 109.02,
    "end": 109.52,
    "speaker": 0,
    "text": "なんだっけ。"
  },
  {
    "index": 38,
    "start": 109.6,
    "end": 109.86,
    "speaker": 0,
    "text": "なんか"
  },
  {
    "index": 39,
    "start": 110.84,
    "end": 116.44,
    "speaker": 0,
    "text": "生春巻きをタイ料理屋さんで頼んだ時に三つ乗ってますみたいな風に言われて。"
  },
  {
    "index": 40,
    "start": 116.94,
    "end": 117.98,
    "speaker": 0,
    "text": "二つにできますか？"
  },
  {
    "index": 41,
    "start": 117.98,
    "end": 118.36,
    "speaker": 0,
    "text": "みたいな。"
  },
  {
    "index": 42,
    "start": 118.96,
    "end": 120.1,
    "speaker": 0,
    "text": "値段一緒でいいんで。"
  },
  {
    "index": 43,
    "start": 120.16,
    "end": 121.52,
    "speaker": 1,
    "text": "いいんだから富豪やん。"
  },
  {
    "index": 44,
    "start": 122.6,
    "end": 122.88,
    "speaker": 0,
    "text": "そう。"
  },
  {
    "index": 45,
    "start": 122.9,
    "end": 123.4,
    "speaker": 0,
    "text": "でもなんか"
  },
  {
    "index": 46,
    "start": 124.48,
    "end": 127.04,
    "speaker": 0,
    "text": "おじさんに言われた方が嫌かもじゃないですか。"
  },
  {
    "index": 47,
    "start": 129.06,
    "end": 130.36,
    "speaker": 1,
    "text": "もうタメ口関係なく。"
  },
  {
    "index": 48,
    "start": 131.06,
    "end": 134.48,
    "speaker": 0,
    "text": "若者に言われたらただわがままな奴だなってなるけど。"
  },
  {
    "index": 49,
    "start": 134.86,
    "end": 139.1,
    "speaker": 0,
    "text": "なんかおじさんはなんか急に余裕を見せてきて、ちょっと嫌かもしれない。"
  },
  {
    "index": 50,
    "start": 139.66,
    "end": 140.86,
    "speaker": 1,
    "text": "そういうこと？"
  },
  {
    "index": 51,
    "start": 140.86,
    "end": 142.38,
    "speaker": 1,
    "text": "俺この値段同じ値段で。"
  },
  {
    "index": 52,
    "start": 142.92,
    "end": 143.96,
    "speaker": 0,
    "text": "少なくていいけど。"
  },
  {
    "index": 53,
    "start": 144.04,
    "end": 145.02,
    "speaker": 1,
    "text": "いいんだぜっていう。"
  },
  {
    "index": 54,
    "start": 145.96,
    "end": 146.7,
    "speaker": 0,
    "text": "小さすぎる。"
  },
  {
    "index": 55,
    "start": 147.04,
    "end": 148.12,
    "speaker": 0,
    "text": "小さいおじさんすぎる。"
  },
  {
    "index": 56,
    "start": 149.14,
    "end": 153.28,
    "speaker": 1,
    "text": "電車で足をめっちゃ開く人はあんま私気になったことないかも。"
  },
  {
    "index": 57,
    "start": 154.62,
    "end": 156.56,
    "speaker": 1,
    "text": "そんなやつの横に座んないから。"
  },
  {
    "index": 58,
    "start": 156.74,
    "end": 157.06,
    "speaker": 0,
    "text": "確かに。"
  },
  {
    "index": 59,
    "start": 157.94,
    "end": 158.16,
    "speaker": 1,
    "text": "うん。"
  },
  {
    "index": 60,
    "start": 158.92,
    "end": 163.28,
    "speaker": 0,
    "text": "最近どっちかというと足を組んでめっちゃ前に出してくるおじさんの方が気になりますね。"
  },
  {
    "index": 61,
    "start": 163.94,
    "end": 167.68,
    "speaker": 0,
    "text": "横に広いより縦に前に長い方が。"
  },
  {
    "index": 62,
    "start": 168.54,
    "end": 169.64,
    "speaker": 1,
    "text": "長い人間いないって。"
  },
  {
    "index": 63,
    "start": 170.84,
    "end": 172.12,
    "speaker": 0,
    "text": "そう、引っかかっちゃうからね。"
  },
  {
    "index": 64,
    "start": 172.2,
    "end": 173.22,
    "speaker": 0,
    "text": "やめた方がいいですね。"
  },
  {
    "index": 65,
    "start": 173.3,
    "end": 173.68,
    "speaker": 1,
    "text": "そうね。"
  },
  {
    "index": 66,
    "start": 174.84,
    "end": 181.12,
    "speaker": 1,
    "text": "まあそういう表、嫌なおじさん度でいうと、やっぱ道端に痰吐く方が強いかなっていう。"
  },
  {
    "index": 67,
    "start": 181.64,
    "end": 183.3,
    "speaker": 0,
    "text": "おじさんじゃなくても嫌だからな。"
  },
  {
    "index": 68,
    "start": 184,
    "end": 185.6,
    "speaker": 1,
    "text": "いや、おばさんで見たことないんで。"
  },
  {
    "index": 69,
    "start": 186.88,
    "end": 188.84,
    "speaker": 1,
    "text": "道端に唾吐くおばさん見たことない。"
  },
  {
    "index": 70,
    "start": 189.9,
    "end": 190.18,
    "speaker": 0,
    "text": "はい。"
  },
  {
    "index": 71,
    "start": 190.26,
    "end": 190.66,
    "speaker": 0,
    "text": "なので"
  },
  {
    "index": 72,
    "start": 191.48,
    "end": 197.34,
    "speaker": 0,
    "text": "なんか対戦を挑まれましたけども、足は前に出さずに店員さんには丁寧に。"
  },
  {
    "index": 73,
    "start": 197.4,
    "end": 197.92,
    "speaker": 0,
    "text": "はい。"
  },
  {
    "index": 74,
    "start": 198.1,
    "end": 198.9,
    "speaker": 0,
    "text": "話していきましょう。"
  },
  {
    "index": 75,
    "start": 198.96,
    "end": 199.46,
    "speaker": 1,
    "text": "お願いします。"
  },
  {
    "index": 76,
    "start": 199.56,
    "end": 199.74,
    "speaker": 0,
    "text": "はい。"
  },
  {
    "index": 77,
    "start": 200.86,
    "end": 201.48,
    "speaker": 0,
    "text": "今日は"
  },
  {
    "index": 78,
    "start": 202.66,
    "end": 203.92,
    "speaker": 0,
    "text": "電子書籍について。"
  },
  {
    "index": 79,
    "start": 205.1,
    "end": 205.66,
    "speaker": 0,
    "text": "電子書籍"
  },
  {
    "index": 80,
    "start": 206.64,
    "end": 208.48,
    "speaker": 0,
    "text": "をそもそも使っているかでいうと、"
  },
  {
    "index": 81,
    "start": 209.56,
    "end": 218.66,
    "speaker": 0,
    "text": "私は本を何で買っているかを見たんですが、Kindleか紙か、DMMBooksかアメーバブックスみたいな感じでした。"
  },
  {
    "index": 82,
    "start": 218.7,
    "end": 218.88,
    "speaker": 1,
    "text": "うん。"
  },
  {
    "index": 83,
    "start": 220.36,
    "end": 222.38,
    "speaker": 0,
    "text": "で、基本的にはKindle使ってて、"
  },
  {
    "index": 84,
    "start": 223.1,
    "end": 227.14,
    "speaker": 0,
    "text": "読み返しそうだなという本は基本Kindleで買ってます。"
  },
  {
    "index": 85,
    "start": 227.2,
    "end": 227.5,
    "speaker": 1,
    "text": "なるほど。"
  },
  {
    "index": 86,
    "start": 227.6,
    "end": 233.76,
    "speaker": 0,
    "text": "で、一回しか読まなそうだなって本は紙で買ってメルカリですぐ売ってる感じです。"
  },
  {
    "index": 87,
    "start": 233.82,
    "end": 235.38,
    "speaker": 0,
    "text": "なんか電気ものとか。"
  },
  {
    "index": 88,
    "start": 235.8,
    "end": 236.52,
    "speaker": 1,
    "text": "ああ。"
  },
  {
    "index": 89,
    "start": 236.58,
    "end": 236.92,
    "speaker": 0,
    "text": "みたいな"
  },
  {
    "index": 90,
    "start": 237.78,
    "end": 246.54,
    "speaker": 0,
    "text": "感じですね。Kindleにすると基本全部集約できるから、それができるし、外行った時にすぐ見れたりするんで"
  },
  {
    "index": 91,
    "start": 247.42,
    "end": 250.6,
    "speaker": 0,
    "text": "いいなと思うんですが。Kindleは"
  },
  {
    "index": 92,
    "start": 251.94,
    "end": 254.82,
    "speaker": 0,
    "text": "特になんかPCで読もうとすると遅いし、"
  },
  {
    "index": 93,
    "start": 255.58,
    "end": 266.02,
    "speaker": 0,
    "text": "めちゃくちゃ検索がクソだし、並び順が特定のビューでしか変えられなくて、読みたい本がすぐ見つけられないっていうところはちょっと普通に嫌って感じですね。"
  },
  {
    "index": 94,
    "start": 267.06,
    "end": 268.56,
    "speaker": 0,
    "text": "はい、そんな感じです。"
  },
  {
    "index": 95,
    "start": 268.62,
    "end": 271.44,
    "speaker": 0,
    "text": "あと、DMMとかはなんか漫画とか"
  },
  {
    "index": 96,
    "start": 272.4,
    "end": 277.22,
    "speaker": 0,
    "text": "がめっちゃセールになってる時にまとめて買ったやつが一部いるっていう感じです。"
  },
  {
    "index": 97,
    "start": 278.26,
    "end": 278.38,
    "speaker": 0,
    "text": "はい、"
  },
  {
    "index": 98,
    "start": 279.12,
    "end": 280.06,
    "speaker": 0,
    "text": "そんな感じですね。"
  },
  {
    "index": 99,
    "start": 280.6,
    "end": 280.86,
    "speaker": 1,
    "text": "うん。"
  },
  {
    "index": 100,
    "start": 282.04,
    "end": 283.06,
    "speaker": 1,
    "text": "そうですね。"
  },
  {
    "index": 101,
    "start": 283.14,
    "end": 284.8,
    "speaker": 1,
    "text": "なんかKindleって"
  },
  {
    "index": 102,
    "start": 286.1,
    "end": 288.76,
    "speaker": 1,
    "text": "買う時というか、体験別に悪くない"
  },
  {
    "index": 103,
    "start": 289.64,
    "end": 289.8,
    "speaker": 1,
    "text": "し、"
  },
  {
    "index": 104,
    "start": 290.98,
    "end": 292.48,
    "speaker": 1,
    "text": "一箇所に集約できていいんだけど、"
  },
  {
    "index": 105,
    "start": 293.28,
    "end": 295.94,
    "speaker": 1,
    "text": "なんであんなビューワーに力を入れないんだろうっていうぐらい、"
  },
  {
    "index": 106,
    "start": 297.12,
    "end": 303.88,
    "speaker": 1,
    "text": "なんかMac版とか何かたまに立ち上がんない時あるし、めっちゃ遅いし、ダウンロードもなんかすごい遅い"
  },
  {
    "index": 107,
    "start": 305.18,
    "end": 306.4,
    "speaker": 1,
    "text": "し、なんかモッサリしてるし。"
  },
  {
    "index": 108,
    "start": 306.92,
    "end": 313.96,
    "speaker": 0,
    "text": "スマホはまあそんなスピードは気にならんって感じですけど、PC版はだいぶクソですよね。"
  },
  {
    "index": 109,
    "start": 314.36,
    "end": 314.8,
    "speaker": 0,
    "text": "クソって言って。"
  },
  {
    "index": 110,
    "start": 314.88,
    "end": 315.5,
    "speaker": 1,
    "text": "そうなんすよ。"
  },
  {
    "index": 111,
    "start": 316.36,
    "end": 320.96,
    "speaker": 1,
    "text": "なんでクラウドリーダーをウェブで読めるならそっちの方が体験いい説あるんですよね。"
  },
  {
    "index": 112,
    "start": 321.06,
    "end": 321.64,
    "speaker": 0,
    "text": "なるほどね。"
  },
  {
    "index": 113,
    "start": 322.82,
    "end": 334.04,
    "speaker": 0,
    "text": "で、Kindleいいなってなるのが、あのマーカーを引いてメモをつけたりとか、それを後でReaderで集約して見返せるとこってすごい使ってるんですけど。"
  },
  {
    "index": 114,
    "start": 335.04,
    "end": 345.24,
    "speaker": 0,
    "text": "なんかこれ別にKindleのせいじゃないんですけど、資格系の本とかでもう画像データがそのまま電子書籍になってるタイプのやつだと、もう何もメモも取れないし、"
  },
  {
    "index": 115,
    "start": 346.16,
    "end": 357.16,
    "speaker": 0,
    "text": "なんかそもそも読む時に拡大するのをなんか毎回やって縮小してページ送りしてみたいにしないといけなくて、めちゃくちゃだるいので、ちょっとその辺のデータがもうちょっといい感じに作られたら"
  },
  {
    "index": 116,
    "start": 358.16,
    "end": 360.36,
    "speaker": 0,
    "text": "消費者的には嬉しいなって思います。"
  },
  {
    "index": 117,
    "start": 361.32,
    "end": 361.64,
    "speaker": 1,
    "text": "あの"
  },
  {
    "index": 118,
    "start": 362.42,
    "end": 364.98,
    "speaker": 1,
    "text": "文字選択できない系マジで辛いですよね。"
  },
