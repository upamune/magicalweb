  {
    "index": 53,
    "start": 198.52,
    "end": 200.18,
    "speaker": 0,
    "text": "まあ寒くないだけ全然ありがたい。"
  },
  {
    "index": 54,
    "start": 200.18,
    "end": 200.52,
    "speaker": 1,
    "text": "あ、そうですね。"
  },
  {
    "index": 55,
    "start": 200.54,
